<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the Paperclip watchdog, every five minutes.

  This file is a template, not an installed agent. A person installs it by
  hand, with the commands below, and it does nothing until they do. Run
  scripts/paperclip-apply.py once before, because the watchdog needs the
  scope-creep label to exist.

  Two markers are substituted, both from bootstrap.settings.json at the
  workbench root:

    <reverse.dns.prefix>              launchd_label_prefix
    <absolute path of this workbench> workbench_path_in_templates

  Substitute them with:

    python3 -c "import importlib.util,pathlib; \
      s=importlib.util.spec_from_file_location('n','scripts/paperclip-new-org.py'); \
      m=importlib.util.module_from_spec(s); s.loader.exec_module(m); \
      print(m.render_watchdog_template(), end='')"

  which is the same renderer scripts/bootstrap.py uses, so the installed file
  and the checked step never disagree. The paths it writes are absolute
  because launchd resolves nothing; rerun it if the workbench moves.

  The watchdog calls no model. It reads the local Paperclip API, pauses an
  agent at its daily run cap or after an authentication failure burst, and
  parks issues that no person or routine created. A pass with nothing to do
  costs under a second.

  A cap-paused agent never resumes on its own. There is no new-day resume, so
  a fleet-total pause stops every agent and waits for a person. No run cap
  anywhere may be 0: at every enforcement site a 0 reads as "no cap
  configured" and disables the breaker instead of stopping the agent.

  Install (writing <reverse.dns.prefix> and the rendered body yourself):
    cp scripts/paperclip-watchdog.plist.template \
       ~/Library/LaunchAgents/<reverse.dns.prefix>.paperclip-watchdog.plist
    launchctl bootstrap gui/$(id -u) \
       ~/Library/LaunchAgents/<reverse.dns.prefix>.paperclip-watchdog.plist

  Remove:
    launchctl bootout gui/$(id -u)/<reverse.dns.prefix>.paperclip-watchdog
    rm ~/Library/LaunchAgents/<reverse.dns.prefix>.paperclip-watchdog.plist

  Run once, now:
    launchctl kickstart -p gui/$(id -u)/<reverse.dns.prefix>.paperclip-watchdog

  The script writes its own log under .paperclip/, so launchd output goes to
  /dev/null.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string><reverse.dns.prefix>.paperclip-watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string><absolute path of this workbench>/scripts/paperclip-watchdog.py</string>
  </array>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/dev/null</string>

  <key>StandardErrorPath</key>
  <string><absolute path of this workbench>/.paperclip/watchdog.err</string>
</dict>
</plist>
