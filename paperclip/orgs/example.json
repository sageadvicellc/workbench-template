{
  "extends": "../company.json",
  "companyId": "<company id, or null so paperclip-new-org.py creates it>",
  "company": {
    "name": "<second company name>",
    "description": "<one sentence: what this company is for and when it started>"
  },
  "runCaps": {
    "claude_local": {
      "agents": {
        "chief-of-staff": 20,
        "lead": 12
      },
      "harnessTotal": 30
    },
    "default": { "harnessTotal": 30 }
  },
  "agentOverrides": {
    "chief-of-staff": {
      "id": "<agent id, written back by --apply>",
      "runsPerDay": 20
    },
    "lead": {
      "id": "<agent id, written back by --apply>",
      "runsPerDay": 12,
      "maxConcurrentRuns": 2
    }
  },
  "goals": [],
  "watchdog": {
    "logFile": ".paperclip/watchdog-example.log",
    "stateFile": ".paperclip/watchdog-state-example.json"
  }
}
