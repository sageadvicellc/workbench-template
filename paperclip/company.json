{
  "companyId": "<company id from GET /api/companies>",
  "apiBase": "http://127.0.0.1:3100",
  "company": {
    "requireBoardApprovalForNewAgents": true,
    "interactionResolverGovernance": {
      "request_confirmation": {
        "defaultPolicy": "human_only",
        "cap": "human_only"
      }
    }
  },
  "applyAssignmentPolicy": false,
  "applyPipelines": false,
  "experimental": {
    "enableIssueGraphLivenessAutoRecovery": false,
    "enableTaskWatchdogs": false,
    "enableIssuePlanDecompositions": false
  },
  "labels": [
    { "name": "scope-creep", "color": "#b45309" },
    { "name": "idea", "color": "#4338ca" }
  ],
  "runCaps": {
    "claude_local": {
      "agents": {
        "chief-of-staff": 8,
        "lead": 4
      },
      "harnessTotal": 12
    },
    "default": { "harnessTotal": 12 }
  },
  "defaults": {
    "adapterConfig": {
      "cwd": "<absolute path of this workbench>",
      "graceSec": 20
    },
    "adapters": {
      "claude_local": {
        "model": "<model the owner chose>",
        "effort": "medium",
        "dangerouslySkipPermissions": false
      }
    },
    "runtimeConfig": {
      "heartbeat": {
        "enabled": false,
        "intervalSec": 0,
        "cooldownSec": 60,
        "wakeOnDemand": true,
        "maxConcurrentRuns": 1,
        "skipTimerWhenNoActionableWork": true
      }
    },
    "permissions": {
      "canCreateAgents": false,
      "canCreateSkills": false,
      "canAssignTasks": false
    },
    "wakePromptFile": "paperclip/wake-prompt.md"
  },
  "agents": [
    {
      "key": "chief-of-staff",
      "id": "<id of the onboarding agent this company already has>",
      "name": "<chief of staff name>",
      "role": "pm",
      "title": "Chief of staff",
      "adapterType": "claude_local",
      "instructionsFile": "paperclip/agents/chief-of-staff/AGENTS.md",
      "adapterConfig": {
        "maxTurnsPerRun": 60,
        "timeoutSec": 900
      },
      "runsPerDay": 8,
      "reportsTo": null
    },
    {
      "key": "lead",
      "id": null,
      "name": "<lead name>",
      "role": "general",
      "title": "<kind of work> lead",
      "adapterType": "claude_local",
      "instructionsFile": "paperclip/agents/lead/AGENTS.md",
      "adapterConfig": {
        "maxTurnsPerRun": 150,
        "timeoutSec": 3600
      },
      "runsPerDay": 4,
      "reportsTo": "chief-of-staff"
    }
  ],
  "watchdog": {
    "authFailureBurst": 3,
    "authFailurePattern": "<the login-expiry text the owner's runtime writes>",
    "logFile": ".paperclip/watchdog.log",
    "boardUserId": "<owner's board user id, read from an issue>",
    "scopeAgent": "chief-of-staff",
    "leads": {
      "lead": "lead"
    },
    "leadKeys": ["lead"],
    "workerKeys": []
  }
}
